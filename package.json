{
  "name": "capture-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mac-first CLI for Bentley iTwin reality-capture pipelines",
  "bin": {
    "capture": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "capture": "tsx src/cli.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.33.0",
    "@itwin/node-cli-authorization": "^3.1.0",
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
