ITWIN_CLIENT_ID=native-your-client-id
ITWIN_ID=your-itwin-id

# Bentley environment: prod or qa
ITWIN_ENV=prod

# Usually unnecessary; defaults to http://localhost:3000/signin-callback
# ITWIN_REDIRECT_URI=http://localhost:3000/signin-callback

# Optional overrides for nonstandard Bentley environments
# ITWIN_API_BASE_URL=https://api.bentley.com
# ITWIN_ISSUER_URL=https://ims.bentley.com

# Optional explicit token for CI/debugging; bypasses browser auth
# ITWIN_ACCESS_TOKEN=
